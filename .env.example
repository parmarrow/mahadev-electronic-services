PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mahadev_smart_services

# Use a long random secret in production. Required for dashboard actions.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional SMTP configuration for real lead emails.
ADMIN_EMAIL=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Mahadev Smart Assistant <noreply@example.com>

# Optional Google Places API configuration for live Google reviews.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
MAP_QUERY=Mahadev Smart Services
