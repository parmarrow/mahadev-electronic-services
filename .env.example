PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mahadev_smart_services

# Use a long random secret in production. It signs dashboard sessions.
ADMIN_TOKEN=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Customer visit billing used by the admin dashboard.
VISIT_CHARGE=250

# Optional Google Places API configuration for live Google reviews.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
MAP_QUERY=Mahadev Smart Services
